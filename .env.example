# Copy to .env and replace every REPLACE_* value before starting Compose.
APP_ENV=production
HTTP_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DATA_DIRECTORY=/app/data
LEGACY_DATA_PATH=./data

# Production admin password must be at least 16 characters.
ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_ADMIN_PASSWORD

POSTGRES_DB=skyward
POSTGRES_USER=skyward
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
# Compose constructs DATABASE_URL from the POSTGRES_* values; never put it in frontend code.
# For a non-Compose production process, set DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB.
